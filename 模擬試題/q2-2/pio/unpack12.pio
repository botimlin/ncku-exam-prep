; unpack12.pio — 把「緊密打包」的 12-bit 樣本拆開，每個樣本單獨推回 RX FIFO
;
; 規格（見 q2-2/README.md §B-2）：
;   - 樣本 s0, s1, s2, ... 從 bit 0 開始一個接一個排成一條位元流（低位元先），
;     再每 32 bit 切成一個 TX word。所以 8 個樣本剛好是 3 個 word：
;       word0 = s0[11:0] | s1[11:0]<<12 | s2[7:0]<<24
;       word1 = s2[11:8] | s3<<4 | s4<<16 | s5[3:0]<<28
;       word2 = s5[11:4] | s6<<8 | s7<<20
;   - 每個 RX word 的 bits 11..0 = 一個樣本，其他 bit 一律是 0，順序 s0, s1, s2, ...
;   - 評分會送 3 的倍數個 word。
;   - 效能：judge 會數 cycle，每個樣本平均 ≤ 3 cycle 拿滿分。
;
; TODO(改這裡)：寫出這支程式和它的設定。下面只是起點，不是答案。

.program unpack12
.wrap_target
    out x, 12
    in  x, 12
.wrap

% c-sdk {
static inline void unpack12_program_init(PIO pio, uint sm, uint offset) {
    pio_sm_config c = unpack12_program_get_default_config(offset);
    sm_config_set_out_shift(&c, true, true, 32);
    sm_config_set_in_shift(&c,  false, true, 12);
    pio_sm_init(pio, sm, offset, &c);
    pio_sm_set_enabled(pio, sm, true);
}
%}
